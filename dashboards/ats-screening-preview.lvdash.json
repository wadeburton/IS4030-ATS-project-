{
  "datasets": [
    {
      "name": "scores",
      "displayName": "Resume match scores",
      "query": "SELECT * FROM workspace.is4030_silver.ats_preview_20260929_172928_scores"
    },
    {
      "name": "top_matches",
      "displayName": "Top ten results",
      "query": "SELECT job_title, company, model_name, resume_id, rank_position, similarity_score, matched_terms, domain_group, source_dataset FROM workspace.is4030_silver.ats_preview_20260929_172928_scores WHERE rank_position <= 10"
    },
    {
      "name": "group_averages",
      "displayName": "Average similarity by group",
      "query": "SELECT domain_group, model_name, AVG(similarity_score) AS average_similarity FROM workspace.is4030_silver.ats_preview_20260929_172928_scores GROUP BY domain_group, model_name"
    },
    {
      "name": "data_quality",
      "displayName": "Missing input and truncation summary",
      "query": "SELECT source, action, records FROM workspace.is4030_silver.ats_preview_20260929_172928_quality"
    }
  ],
